// EvaWM default config
//
// `Mod` is Super (or Alt with `--nested-mod alt`).
// Saving this file reloads it live. See docs/config.md for all options.

// strict true
// include "local.kdl"

// Commands to run once at startup.
// startup {
//     spawn "swaybg" "-i" "/path/to/wallpaper.png" "-m" "fill"
//     spawn-sh "wl-paste --type text --watch cliphist store"
// }

// Optional monitor overrides
// output "DP-1" {
//     mode "1920x1080@165"
//     transform "normal"
//     position x=0 y=0
// }
//
// output "HDMI-A-1" {
//     mode "1920x1080@75"
//     transform "180"
//     position x=1920 y=0
//     // off
// }

input {
    keyboard {
        // XKB layout (empty fields use system defaults).
        // xkb {
        //     layout "us"
        //     // variant ""
        //     // model ""
        //     // rules ""
        //     // options "caps:escape"
        // }

        // Delay in ms; rate in repeats/sec (0 disables).
        repeat-delay 250
        repeat-rate 25
    }

    cursor {
        // Empty uses $XCURSOR_THEME, then "default".
        theme ""
        size 24
    }

    mouse {
        // "flat" or "adaptive"; accel-speed is -1.0..1.0.
        accel-profile "flat"
        accel-speed 0.0

        // "none", "back", "forward", or "middle".
        // This is for my personal use where i like using the side buttons on my mouse as a button for panning and a button to act as 'mod' for moving/resizing.
        pan-button "none"
        mod-button "none"
    }

    touchpad {
        tap
        natural-scroll

        // Also supported: left-handed, accel-speed, accel-profile.
    }

    focus-follows-mouse {
        scroll true
        canvas true
    }
}

xwayland {
    // Starts xwayland-satellite on demand.
    enabled true
}

layout {
    gaps 8

    inner-border {
        width 3
        active-color "#ffffff"
        inactive-color "#505050"
    }

    // Set width to 0 to disable.
    outer-border {
        width 3
        active-color "#b4b4b4"
        inactive-color "#2a2a2a"
    }

    background-color "#000000"

    // "scroll" or "canvas".
    default-mode "scroll"

    default-column-width { proportion 0.5; }

    canvas {
        // Keyboard camera pan distance, in logical pixels.
        pan-step 200

        // Keyboard window move distance, in logical pixels.
        move-step 40

        // New window size as a fraction of the working area.
        new-window-width 0.55
        new-window-height 0.60

        // "center", "cursor-center", or "cursor-top-left".
        new-window-position "center"
    }

    overview {
        // Scale while Overview is open (0.1..0.95).
        zoom 0.5
    }
}

animations {
    // Uncomment to disable all animations (individual blocks also accept `off`).
    // off

    // Speed multiplier (> 1 slower, < 1 faster).
    slowdown 1.0

    // Each block uses either a spring or an easing:
    //   spring damping-ratio=0.8 stiffness=900 epsilon=0.0007
    //   duration-ms 150
    //   curve "ease-out-cubic"
    //
    // Curves: linear, ease-in-out, ease-out-quad, ease-out-cubic,
    // ease-out-expo, ease-out-back, ease-in-out-back, cubic-bezier x1 y1 x2 y2.

    view-movement {
        spring damping-ratio=0.9 stiffness=900 epsilon=0.0007
    }

    window-movement {
        spring damping-ratio=0.82 stiffness=900 epsilon=0.0007
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0005
    }

    window-open {
        spring damping-ratio=0.72 stiffness=800 epsilon=0.001
        scale-from 0.9
        opacity-from 0.0
    }

    window-close {
        duration-ms 120
        curve "ease-out-quad"
        scale-to 0.92
    }

    overview {
        spring damping-ratio=0.9 stiffness=900 epsilon=0.0007
    }
}

binds {
    // Applications

    Mod+Return  { spawn "foot"; }
    Mod+A       { spawn "fuzzel"; }
    Mod+Q       { close-window; }
    Mod+Shift+E { quit; }

    // Focus

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Tab       { cycle-window "next"; }
    Mod+Shift+Tab { cycle-window "previous"; }

    // Move

    Mod+Shift+Left  { move-window-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-window-right; }
    Mod+Shift+H     { move-window-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-window-right; }

    Mod+Alt+Shift+Left  { move-column-left; }
    Mod+Alt+Shift+Right { move-column-right; }
    Mod+Alt+Shift+H     { move-column-left; }
    Mod+Alt+Shift+L     { move-column-right; }

    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+Ctrl+Shift+Left  { move-to-monitor-left; }
    Mod+Ctrl+Shift+Down  { move-to-monitor-down; }
    Mod+Ctrl+Shift+Up    { move-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-to-monitor-right; }
    Mod+Ctrl+Shift+H     { move-to-monitor-left; }
    Mod+Ctrl+Shift+J     { move-to-monitor-down; }
    Mod+Ctrl+Shift+K     { move-to-monitor-up; }
    Mod+Ctrl+Shift+L     { move-to-monitor-right; }

    // Resize

    Mod+Minus       { resize-width "-10%"; }
    Mod+Equal       { resize-width "+10%"; }
    Mod+Shift+Minus { resize-height "-10%"; }
    Mod+Shift+Equal { resize-height "+10%"; }

    // Layout

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+F            { maximize-column; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+C            { center-column; }
    Mod+Shift+Return { fullscreen-window; }

    // Workspaces

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // Canvas & Overview

    Mod+B        { toggle-canvas; }
    Mod+O        { toggle-overview; }
    Mod+Alt+Left  { pan-camera "left"; }
    Mod+Alt+Right { pan-camera "right"; }
    Mod+Alt+Up    { pan-camera "up"; }
    Mod+Alt+Down  { pan-camera "down"; }
    Mod+Alt+Home  { home-canvas; }
}

// Built-in mouse drags:
//   Mod + left-drag          move window
//   Mod + right-drag         resize window
//   Mod + Shift + left-drag  pan canvas
//   mod-button / pan-button  configured under input.mouse
